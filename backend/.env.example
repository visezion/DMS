APP_NAME=DMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dms
DB_USERNAME=dms
DB_PASSWORD=dms

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=dms

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dms.local"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_FALLBACK_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_TEMPERATURE=0.15
OPENAI_ASSISTANT_MAX_COMPLETION_TOKENS=700
OPENAI_ASSISTANT_TIMEOUT_SECONDS=8
OPENAI_ASSISTANT_CONNECT_TIMEOUT_SECONDS=2
OPENAI_ASSISTANT_RETRY_TIMES=0
OPENAI_ASSISTANT_RETRY_SLEEP_MS=120
OPENAI_ASSISTANT_HISTORY_MESSAGES=8
OPENAI_ASSISTANT_EXPOSE_PROVIDER_ERRORS=false
OPENAI_ASSISTANT_REDACT_BEHAVIOR_DETAILS=true
OPENAI_TIMEOUT_SECONDS=12
OPENAI_BEHAVIOR_ANALYST_ENABLED=true
OPENAI_BEHAVIOR_HISTORY_EVENTS=150
OPENAI_BEHAVIOR_MIN_CONFIDENCE=0.60
OPENAI_AI_POWER_ENABLED=true
OPENAI_AI_POWER_MODEL=gpt-4o-mini
OPENAI_AI_POWER_TIMEOUT_SECONDS=12
OPENAI_AI_POWER_PROMPT_VERSION=v2
OPENAI_AI_POWER_PROMPT_EXTRA=
OPENAI_AI_POWER_POLICY_PROMPT_VERSION=v2
OPENAI_AI_POWER_POLICY_PROMPT_EXTRA=
OPENAI_AI_POWER_REVIEW_PROMPT_VERSION=v2
OPENAI_AI_POWER_REVIEW_PROMPT_EXTRA=
OPENAI_AI_POWER_ONLINE_WINDOW_MINUTES=5
DMS_COMMAND_CATALOG_VERSION=v1

DMS_ENFORCE_MTLS=false
DMS_COMMAND_SIGNING_REQUIRED=true
DMS_KEYSET_CACHE_SECONDS=300
DMS_STANDALONE_MODE=true
DMS_SIGNATURE_MODE=digest
DMS_SIGNATURE_COMPAT_MODES=digest,canonical,digest_hex,raw_json,raw_json_digest
# Agent-side emergency switch (set on endpoint environment, not backend):
# DMS_SIGNATURE_BYPASS=true
DMS_SIGNATURE_DEBUG=false
DMS_INTELLIGENCE_QUEUE=default
DMS_INTELLIGENCE_DISPATCH_DEBOUNCE_SECONDS=45
DMS_FINDING_STALE_MINUTES=30
DMS_INTELLIGENCE_FRESHNESS_STALE_MINUTES=120
DMS_BEHAVIOR_LOG_ALLOW_CHECKIN_FALLBACK=true
DMS_BEHAVIOR_LOG_CHECKIN_FALLBACK_WINDOW_MINUTES=15
DMS_CHECKIN_INTERVAL_SECONDS=60
DMS_NONCE_WINDOW_SECONDS=300
DMS_REMOTE_SUPPORT_ACTIVE_CHECKIN_INTERVAL_SECONDS=1
DMS_REMOTE_SUPPORT_ACTIVE_CAPTURE_WINDOW_SECONDS=45

# Seeder bootstrap defaults
DMS_SEED_TENANT_NAME="Default Tenant"
DMS_SEED_TENANT_SLUG=default
DMS_SEED_ADMIN_NAME="DMS Admin"
DMS_SEED_ADMIN_EMAIL=admin@example.com
DMS_SEED_ADMIN_PASSWORD=change_me

# Allow public organization self-signup page (/admin/signup)
# Ignored when DMS_STANDALONE_MODE=true.
DMS_SELF_SIGNUP_ENABLED=true

# Optional local Python backend launcher used by Admin -> Agent Delivery
# If unset, DMS uses bundled backend at /var/www/html/agent-backend (if present).
# AGENT_BACKEND_WORKDIR=/opt/apps/agent-backend
# AGENT_BACKEND_WORKDIR=C:\path\to\python-backend
# AGENT_BACKEND_START_COMMAND="python -m uvicorn app.main:app --host 127.0.0.1 --port 8000"
# AGENT_BACKEND_HOST=127.0.0.1
# AGENT_BACKEND_PORT=8000

