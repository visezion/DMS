<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <UseRidGraph>true</UseRidGraph>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dms.Agent.Core\Dms.Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.MixedReality.WebRTC" Version="2.0.2" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <Target Name="CopyMixedRealityNativeRuntime" AfterTargets="Build;Publish">
    <PropertyGroup>
      <MixedRealityNativeDll>$(PkgMicrosoft_MixedReality_WebRTC)\runtimes\win10-x64\native\mrwebrtc.dll</MixedRealityNativeDll>
    </PropertyGroup>

    <Copy SourceFiles="$(MixedRealityNativeDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MixedRealityNativeDll)') and '$(OutDir)' != ''" />

    <Copy SourceFiles="$(MixedRealityNativeDll)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MixedRealityNativeDll)') and '$(PublishDir)' != ''" />
  </Target>
</Project>
